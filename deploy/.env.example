# 线上密钥。install.sh 第一次运行时会自动生成 deploy/.env（随机值），一般不用手动复制。
# 手动部署时：cp deploy/.env.example deploy/.env，再把所有 change-me 换成随机字符串
#   （只用字母和数字，比如 openssl rand -hex 24 的结果）。不要提交 .env。
# 已有的 .env 不会被 install.sh 覆盖；换密钥要自己改，改完 docker compose ... up -d 生效。

POSTGRES_PASSWORD=change-me-postgres

# 客户端要用：会写进 deploy/client-server.json 的 server_key
NAKAMA_SERVER_KEY=change-me-server-key

# 管理控制台登录（ssh -L 7351:127.0.0.1:7351 后浏览器打开 http://127.0.0.1:7351）
NAKAMA_CONSOLE_USER=admin
NAKAMA_CONSOLE_PASSWORD=change-me-console

# 这四个 Nakama 的默认值是公开的，不换的话别人能伪造登录令牌 / 控制台会话
NAKAMA_SESSION_ENCRYPTION_KEY=change-me-session
NAKAMA_SESSION_REFRESH_ENCRYPTION_KEY=change-me-refresh
NAKAMA_RUNTIME_HTTP_KEY=change-me-http
NAKAMA_CONSOLE_SIGNING_KEY=change-me-signing

# 你的域名（先加一条 A 记录指向服务器）。没有域名就用 <公网IP用横线连>.sslip.io，例如 1-2-3-4.sslip.io
DOMAIN=tongsui.example.com
# 可选：Let's Encrypt 通知邮箱，留空也能申请证书
ACME_EMAIL=
