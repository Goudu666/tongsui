   ],
   "lines": {
    "childhood": [
     "嘘——别嚷，鱼都让你们吓跑了。",
     "钓上来的小鲫鱼，回家熬汤。"
    ],
    "teen": [
     "我钓的不是鱼，是清静。"
    ],
    "young": [
     "对岸拆烟囱那天，鱼三天没咬钩。"
    ],
    "middle": [
     "年轻人问我一天钓几条。我说钓一天，够了。"
    ],
    "old": [
     "我爸就在这儿钓。水还是这水。"
    ]
   }
  },
